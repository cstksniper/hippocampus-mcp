# ============================================================
# HippoMCP configuration template
# Variables are read from the **process environment**: the host
# configuration's env block, or export in the shell.
# You may also copy this as .env for your own loading flow
# (.env is excluded by .gitignore and never enters the repository)
# ============================================================

# --- Memory library directory ---
# If unset the default path is used; point it at your own corpus memory
# library; this directory will not be committed
# HIPPOCAMPUS_PERSIST_DIR=./data/my_memory

# --- Embedding model ---
# If unset, auto-selected by system language: Chinese systems →
#                        BAAI/bge-base-zh-v1.5 (768D)
#                        other languages → all-MiniLM-L6-v2 (384D)
# An explicit value always wins (when an old library already has vectors,
# the in-library model is still followed automatically; no silent recompute)
# HIPPOCAMPUS_EMB_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Turn off auto-selection, always use the English baseline: HIPPOCAMPUS_EMB_MODEL_AUTO=0

# --- Over-long content disposition ---
# Embedding models have a hard token ceiling (BGE/MiniLM = 512,
# Chinese ≈ 500 chars). The excess is **written but not retrievable** —
# with the BM25 literal channel off, pure semantics cannot recall it at all.
#   warn   (default) only self-reports truncated/embedded_chars, no rewrite
#   split  automatically splits into multiple cards written separately
#          (measured: the tail fact of a 3098-char long text recalled at rank 1)
#   reject refuses the write and returns the fix
# HIPPOCAMPUS_LONG_CONTENT=split

# --- HuggingFace mirror (recommended for China networks) ---
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# --- Storage backend ---
# json   = multi-file full rewrite (default)
# sqlite = single-file library, writing 1 entry lands ~28KB
#          (json is one 43MB full rewrite)
# ⚠️ Old libraries are **not auto-migrated**: before switching to sqlite run
#    python scripts/migrate_store.py to-sqlite --dir <memory library directory>
# HIPPOCAMPUS_STORE_BACKEND=json

# --- Full-text search persisted to disk (saves the in-memory BM25 index) ---
# Only meaningful with STORE_BACKEND=sqlite. Chinese tokenizes by trigram;
# if a query consists only of words of 2 chars or fewer it automatically
# falls back to in-memory BM25 (never an empty recall).
# HIPPOCAMPUS_FTS5=0

# --- Embedding backend (saves ~280MB resident memory) ---
# torch = sentence-transformers
# onnx  = onnxruntime + Rust tokenizer, no torch loaded at runtime
# auto  = use the ONNX artifact when present, otherwise torch (default)
# Before using onnx, export first: python scripts/export_onnx.py
#       then verify:   python scripts/verify_onnx.py   (requires cos >= 0.9999)
# HIPPOCAMPUS_EMB_BACKEND=auto

# --- LNN temporal-core backend (the zero-torch production path switch) ---
# numpy = pure-numpy replica of ncps WiredCfCCell (default; the process
#         loads no torch)
# torch = ncps.torch implementation (lazy import; for fallback/comparison;
#         already passed a bit-for-bit A/B against the numpy core)
# HIPPOCAMPUS_LNN_BACKEND=numpy

# --- Multiple libraries ---
# Max libraries resident in the process; beyond that, evicted by LRU
# (eviction saves first, no data loss)
# HIPPOCAMPUS_MAX_RESIDENT_LIBS=2

# --- Runtime memory ---
# OpenBLAS threads default to 4: the scipy-openblas bundled with numpy
# reserves thread buffers by core count by default; on many-core machines
# import alone commits hundreds of MB of private virtual memory (measured
# 754.7MB on 32 cores; not in the working set but eats into the commit
# limit). Capped at 4, commit is 111.8MB and retrieval latency drops
# slightly instead of rising. An explicit setting wins.
# OPENBLAS_NUM_THREADS=4
# Whether loading English NER (spaCy) may pull torch into the process.
# Blocked by default (thinc.compat's import torch is intercepted by a
# temporary sentinel, saving ~160MB resident; Chinese libraries never go
# through spaCy anyway). Set 1 when evaluation scripts need real torch
# (or import torch before using brain; the sentinel yields automatically).
# HIPPOCAMPUS_NER_ALLOW_TORCH=0

# --- daemon mode ---
# 1 = connect to the daemon via the launcher; N sessions share one process
#     (what is saved is the "number of copies", not "the single copy")
# Default 0 = direct connection
# HIPPOCAMPUS_LAUNCHER=0
# Orphan reaping: after all sessions close, once the daemon has been idle
# longer than this many seconds → save all libraries + clear the registry + exit.
# 0 = disabled (never auto-exits). Default 600.
# HIPPOCAMPUS_DAEMON_IDLE_EXIT=600


# ============================================================
# Evaluation judge (**optional** — the core memory service does not
# depend on it at all)
# ============================================================
# Evaluation needs a large model as judge, but "which provider" is a
# replaceable implementation detail, so it is abstracted into the three
# environment variables below. Any OpenAI-compatible
# /chat/completions endpoint works: self-hosted inference, local
# deployments, commercial services all fine.
#
# Changing the judge means changing only these lines, no code. No vendor
# names appear in the project.
# With missing configuration the evaluation scripts raise explicitly,
# never silently falling back.
#
# The only integration boundary: scripts/judge_client.py
#
# This file is only a template; the core service reads these variables
# from the **process environment** (the host configuration's env block,
# or export in the shell); already-exported values win.

# The three required items (export, or put into the host configuration's env block)
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
