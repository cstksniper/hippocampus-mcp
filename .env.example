# ============================================================
# HippoMCP 配置模板
# 变量从**进程环境**读取：宿主配置的 env 块，或 shell 里 export。
# 也可复制为 .env 配合你自己的加载流程（.env 已被 .gitignore 排除，不会进仓库）
# ============================================================

# --- 记忆库目录 ---
# 不设则用默认路径；指向你自己的语料记忆库，该目录不会被提交
# HIPPOCAMPUS_PERSIST_DIR=./data/my_memory

# --- 嵌入模型 ---
# 不设则按系统语言自动选：中文系统 → BAAI/bge-base-zh-v1.5（768D）
#                        其余语言 → all-MiniLM-L6-v2（384D）
# 显式设值则完全以它为准（老库已有向量时仍自动沿用库内模型，不会静默重算）
# HIPPOCAMPUS_EMB_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 关掉自动选型、恒用英文基线：HIPPOCAMPUS_EMB_MODEL_AUTO=0

# --- 超长内容处置 ---
# 嵌入模型有 token 硬上限（BGE/MiniLM = 512，中文≈500 字）。超过的部分
# **写进去了但检索不到**——关掉 BM25 字面通道后纯语义完全召回不到。
#   warn   （默认）只自曝 truncated/embedded_chars，不改写
#   split  自动拆成多张卡分别写入（实测：3098 字长文尾部事实 rank 1 召回）
#   reject 拒写并返回改法
# HIPPOCAMPUS_LONG_CONTENT=split

# --- HuggingFace 镜像（国内网络建议设）---
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# --- 存储后端 ---
# json   = 多文件整份重写（默认）
# sqlite = 单文件库，写 1 条只落 ~28KB（json 是一次 43MB 全量重写）
# ⚠️ 老库**不会自动迁移**：切到 sqlite 前先跑
#    python scripts/migrate_store.py to-sqlite --dir <记忆库目录>
# HIPPOCAMPUS_STORE_BACKEND=json

# --- 全文检索上盘（省掉内存里的 BM25 索引）---
# 只在 STORE_BACKEND=sqlite 下有意义。中文用 trigram 分词，
# 查询里若全是 2 字以内的词会自动回退内存 BM25（不会空召回）。
# HIPPOCAMPUS_FTS5=0

# --- 嵌入后端（省 ~280MB 常驻内存）---
# torch = sentence-transformers
# onnx  = onnxruntime + Rust tokenizer，运行期不加载 torch
# auto  = 有 ONNX 产物就用，没有就用 torch（默认）
# 用 onnx 前先导出：python scripts/export_onnx.py
#       再校验：      python scripts/verify_onnx.py   （要求 cos >= 0.9999）
# HIPPOCAMPUS_EMB_BACKEND=auto

# --- LNN 时序核后端（零 torch 生产路径的开关）---
# numpy = 纯 numpy 复刻 ncps WiredCfCCell（默认；进程不加载 torch）
# torch = ncps.torch 实现（惰性导入；回退/对照用，与 numpy 核已过逐位 A/B）
# HIPPOCAMPUS_LNN_BACKEND=numpy

# --- 多库 ---
# 进程内最多常驻几个库，超了按 LRU 换出（换出前会先 save，不丢数据）
# HIPPOCAMPUS_MAX_RESIDENT_LIBS=2

# --- 运行时内存 ---
# OpenBLAS 线程数默认 4：numpy 捆绑的 scipy-openblas 默认按核数预留线程缓冲，
# 多核机器上 import 即提交数百 MB 私有虚拟内存（32 核实测 754.7MB，不占工作集
# 但吃 commit 上限）。限 4 后 commit 111.8MB，检索延迟不升反微降。显式设置优先。
# OPENBLAS_NUM_THREADS=4
# 英文 NER（spaCy）加载时是否允许把 torch 拉进进程。默认封堵（thinc.compat
# 的 import torch 被临时哨兵拦下，省 ~160MB 常驻；中文库本来就不走 spaCy）。
# 评测脚本需要真 torch 时设 1（或先 import torch 再用 brain，哨兵自动让路）。
# HIPPOCAMPUS_NER_ALLOW_TORCH=0

# --- daemon 模式 ---
# 1 = 经 launcher 连 daemon，N 个会话共用一个进程（省的是"份数"不是"单份"）
# 默认 0 = 直连
# HIPPOCAMPUS_LAUNCHER=0
# 孤儿回收：所有会话关闭后 daemon 空闲超过该秒数 → save 全部库 + 清注册表 + 退出。
# 0 = 关闭（永不自动退出）。默认 600。
# HIPPOCAMPUS_DAEMON_IDLE_EXIT=600


# ============================================================
# 评测 judge（**可选** —— 核心记忆服务完全不依赖）
# ============================================================
# 评测需要一个大模型当裁判，但"用哪家"是可替换的实现细节，
# 所以抽象成下面三件环境变量。填任一家 OpenAI 兼容的
# /chat/completions 端点即可：自建推理、本地部署、商用服务都行。
#
# 换 judge 只改这三行，不改任何代码。项目里不出现服务商名称。
# 缺配置时评测脚本会显式报错，不会静默回退。
#
# 唯一接入边界见 scripts/judge_client.py
#
# 本文件只是模板；核心服务从**进程环境**读这些变量
# （宿主配置的 env 块、或 shell 里 export），已 export 的值优先。

# 必填三件（export 或写进宿主配置的 env 块）
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
